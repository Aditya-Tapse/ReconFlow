# Which extraction provider to use: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama

# Ollama (local, default) - requires `ollama serve` running locally
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# OpenAI (used only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (used only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Gemini (used only if LLM_PROVIDER=gemini) - free tier available at aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
